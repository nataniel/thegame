{
  "name": "xpect/thegame",
  "config": {
    "platform": {
      "php": "7.4.28"
    },
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "authors": [
    {
      "name": "Artur Jedlinski",
      "email": "artur@jedlinski.pl"
    }
  ],
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/nataniel/e4u-framework"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^8.5"
  },
  "require": {
    "nataniel/e4u-framework": "dev-master",
    "ext-openssl": "*"
  },
  "autoload": {
    "psr-4": {
      "Main\\": "application/src/",
      "MainTest\\": "tests/src/"
    }
  }
}
